# ── Core Django settings ────────────────────────────────────────────────
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-50-char-string
# Set to False in production
DEBUG=True
# Comma-separated list, no spaces. e.g. lumerie-eclat-api.onrender.com,localhost
ALLOWED_HOSTS=localhost,127.0.0.1
# Required for admin login to work over HTTPS in production — must include
# scheme (https://). Wildcards like https://*.onrender.com are supported.
CSRF_TRUSTED_ORIGINS=

# ── Database ────────────────────────────────────────────────────────────
# Leave unset to use local SQLite (dev). In production (Render/Railway),
# this is injected automatically as a Postgres connection string.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── JWT ─────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Email (console backend by default — prints emails to the terminal) ──
DEFAULT_FROM_EMAIL=orders@lumerieeclat.com

# ── Superuser bootstrap (optional, used by deploy scripts) ───────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@lumerieeclat.com
DJANGO_SUPERUSER_PASSWORD=change-me
